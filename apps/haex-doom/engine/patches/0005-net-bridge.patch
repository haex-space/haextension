diff --git a/src/net_server.c b/src/net_server.c
index 9374b64e..0f64d241 100644
--- a/src/net_server.c
+++ b/src/net_server.c
@@ -1886,11 +1886,34 @@ static void NET_SV_RunClient(net_client_t *client)
     }
 }
 
+// A peer channel closed. The client is treated as if it had left, and NET_SV_RunClient
+// then deactivates it, so the other players continue (their tics no longer wait for it).
+
+void NET_SV_PeerClosed(net_addr_t *addr)
+{
+    int i;
+
+    for (i = 0; i < MAXNETNODES; ++i)
+    {
+        if (clients[i].active && clients[i].addr == addr
+         && clients[i].connection.state != NET_CONN_STATE_DISCONNECTED)
+        {
+            NET_Log("server: channel of %s closed", NET_AddrToString(addr));
+            clients[i].connection.state = NET_CONN_STATE_DISCONNECTED;
+            clients[i].connection.disconnect_reason = NET_DISCONNECT_REMOTE;
+        }
+    }
+}
+
 // Add a network module to the server context
 
 void NET_SV_AddModule(net_module_t *module)
 {
-    module->InitServer();
+    if (!module->InitServer())
+    {
+        // haex-doom: a module is not ready (no peer session), and a server without it would wait forever.
+        I_Error("NET_SV_AddModule: Unable to start the network module");
+    }
     NET_AddModule(server_context, module);
 }
 
