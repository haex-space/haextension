         emscripten_sleep(us / 1000);
+        if (SDL_TICKS_PASSED(SDL_GetTicks(), give_up))
+        {
+            // The pending callback points at delay_data on this stack frame.
+            OPL_ClearCallbacks();
+            break;
+        }
 #endif
     }
 
