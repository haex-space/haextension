diff --git a/src/net_client.c b/src/net_client.c
index dce769ec..9ab2dcfa 100644
--- a/src/net_client.c
+++ b/src/net_client.c
@@ -288,6 +288,9 @@ static void NET_CL_AdvanceWindow(void)
 
 // Shut down the client code, etc.  Invoked after a disconnect.
 
+// haex-doom: the connection reached the server (not just a SYN that is still unanswered).
+static boolean net_client_established = false;
+
 static void NET_CL_Shutdown(void)
 {
     if (net_client_connected)
@@ -1034,7 +1037,13 @@ void NET_CL_Run(void)
     if (client_connection.state == NET_CONN_STATE_DISCONNECTED
      || client_connection.state == NET_CONN_STATE_DISCONNECTED_SLEEP)
     {
-        NET_CL_Disconnected();
+        // haex-doom: a disconnect of ours, or a rejected SYN that NET_CL_Connect reports itself,
+        // is not a loss of the server.
+        if (net_client_established
+         && client_connection.disconnect_reason != NET_DISCONNECT_LOCAL)
+        {
+            NET_CL_Disconnected();
+        }
 
         NET_CL_Shutdown();
     }
@@ -1099,6 +1108,7 @@ boolean NET_CL_Connect(net_addr_t *addr, net_connect_data_t *data)
     NET_AddModule(client_context, addr->module);
 
     net_client_connected = true;
+    net_client_established = false;
     net_client_received_wait_data = false;
     sent_hole_punch = false;
 
@@ -1152,6 +1162,7 @@ boolean NET_CL_Connect(net_addr_t *addr, net_connect_data_t *data)
         SetRejectReason(NULL);
         client_state = CLIENT_STATE_WAITING_LAUNCH;
         drone = data->drone;
+        net_client_established = true;
 
         return true;
     }
