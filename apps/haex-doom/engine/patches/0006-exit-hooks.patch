diff --git a/src/d_loop.c b/src/d_loop.c
index db3977ed..e055e0a8 100644
--- a/src/d_loop.c
+++ b/src/d_loop.c
@@ -261,6 +261,11 @@ static void D_Disconnected(void)
     // disconnected from server
 
     printf("Disconnected from server.\n");
+
+    // haex-doom: without the server there is no game for a guest to go on with; the shell
+    // shows the notice. (A guest that leaves, or a host that quits, does not pass here: they are
+    // already quitting.)
+    I_QuitWithNotice("Disconnected from the host.");
 }
 
