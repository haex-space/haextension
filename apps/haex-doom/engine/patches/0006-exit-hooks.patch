diff --git a/src/i_system.c b/src/i_system.c
index 7b0e0ee9..b2bebedd 100644
--- a/src/i_system.c
+++ b/src/i_system.c
@@ -49,6 +49,10 @@
 #include "w_wad.h"
 #include "z_zone.h"
 
+#ifdef __EMSCRIPTEN__
+#include "haex_imports.h"
+#endif
+
 #define DEFAULT_RAM 16*2 /* MiB [crispy] */
 #define MIN_RAM     4*4  /* MiB [crispy] */
 
@@ -258,10 +262,19 @@ void I_BindVariables(void)
 // I_Quit
 //
 
+// haex-doom: set once I_Quit or I_Error runs; a netgame's shutdown can report a disconnect
+// that must not start a second exit.
+static boolean quit_in_progress = false;
+
+// haex-doom: the notice the shell shows after a plain Quit ("" for none).
+static const char *quit_notice = "";
+
 void I_Quit (void)
 {
     atexit_listentry_t *entry;
 
+    quit_in_progress = true;
+
     // Run through all exit functions
  
     entry = exit_funcs; 
@@ -274,9 +287,27 @@ void I_Quit (void)
 
     SDL_Quit();
 
+#ifdef __EMSCRIPTEN__
+    // haex-doom: tell the shell why the engine ends.
+    haex_engine_exit(0, quit_notice);
+#endif
+
     exit(0);
 }
 
+// haex-doom: ends the game like Quit and has the shell show the notice, for a game that cannot
+// go on without an error of the engine (such as the host of a netgame leaving).
+void I_QuitWithNotice(const char *notice)
+{
+    if (quit_in_progress)
+    {
+        return;
+    }
+
+    quit_notice = notice;
+    I_Quit();
+}
+
 
 
 //
@@ -290,7 +321,9 @@ void I_Error (const char *error, ...)
     char msgbuf[512];
     va_list argptr;
     atexit_listentry_t *entry;
+#ifndef __EMSCRIPTEN__
     boolean exit_gui_popup;
+#endif
 
     if (already_quitting)
     {
@@ -300,6 +333,7 @@ void I_Error (const char *error, ...)
     else
     {
         already_quitting = true;
+        quit_in_progress = true;
     }
 
     // Message first.
@@ -330,6 +364,10 @@ void I_Error (const char *error, ...)
         entry = entry->next;
     }
 
+#ifdef __EMSCRIPTEN__
+    // haex-doom: the shell shows the message (instead of a message box) and returns to its start screen.
+    haex_engine_exit(1, msgbuf);
+#else
     //!
     // @category obscure
     //
@@ -346,6 +384,7 @@ void I_Error (const char *error, ...)
         SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR,
                                  PACKAGE_STRING, msgbuf, NULL);
     }
+#endif
 
     // abort();
 
